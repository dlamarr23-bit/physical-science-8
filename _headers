# Cloudflare Pages headers for Class Pass (copied to the root of the physical-science-8 repo as _headers).
# No other website may show the Class Pass pages inside a frame (clickjacking the sign-in or Sign out).
/pass/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
# The assignment pages may be kept for a minute, so the copy the Class Pass page prefetches while a student signs in
# is the one that opens (with max-age=0 the browser downloads it again). The Class Pass page itself is never kept.
/pass/check/*
  Cache-Control: public, max-age=60
/pass/video/*
  Cache-Control: public, max-age=60
/video/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
# The review pages (app/: flashcards, live class games, Class Pass sign-in, the leaderboard; the vocabulary site until
# 2026-11-19, built by app-source/build.mjs in physical-science-8): only that site may show them in a frame (its Review,
# Join a game and Leaderboard pages do), and search engines skip them.
/app/*
  Content-Security-Policy: frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
/app/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
